# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps API (for geocoding and places) - Optional
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# NASA Earthdata (for NDVI/vegetation)
NASA_EARTHDATA_USERNAME=your_nasa_username
NASA_EARTHDATA_PASSWORD="your_nasa_password"

# Note: Traffic data is now provided by OpenStreetMap's Overpass API (no API key required)
